# Supabase Configuration
# Use os nomes gerados pela integração Vercel + Supabase.
# Não coloque valores reais neste arquivo.
DESORDEM_SUPABASE_URL=https://your-project.supabase.co
DESORDEM_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DESORDEM_SUPABASE_ANON_KEY=your-anon-key-here

# Compatibilidade com configuração manual antiga.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server
PORT=3000
NODE_ENV=development
